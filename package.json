{
  "name": "happybaby-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Happy Baby web design system: tokens generated from Figma, React components, Storybook.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "check:browser": "node scripts/check-browser.mjs",
    "check": "npm run typecheck && npm test && npm run check:tokens && npm run build-storybook && npm run check:browser"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "storybook": "8.6.18",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
